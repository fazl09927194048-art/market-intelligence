{
  "manifest_version": 3,
  "name": "Market/Intel — AI Market Overlay",
  "version": "0.4.0",
  "description": "Live market intelligence overlay for supported chart pages. Detects symbols and page prices, connects to the intelligence core, and never fabricates market results.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://*.binance.com/*",
    "https://*.kucoin.com/*",
    "https://*.tradingview.com/*",
    "https://market-intelligence-840b.onrender.com/*"
  ],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Market/Intel"},
  "content_scripts": [{
    "matches": ["https://*.binance.com/*", "https://*.kucoin.com/*", "https://*.tradingview.com/*"],
    "js": ["stream.js", "content.js"],
    "run_at": "document_idle"
  }],
  "icons": {"128": "icon.svg"}
}
