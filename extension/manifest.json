{
  "manifest_version": 3,
  "name": "DRO — AI Market Intelligence",
  "version": "0.7.0",
  "description": "DRO live market intelligence: real-time market stream, multi-timeframe analysis, 33 analyst views, forecast validation, risk, news, events and AI Coach.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://*.binance.com/*",
    "https://*.kucoin.com/*",
    "https://*.tradingview.com/*",
    "https://market-intelligence-840b.onrender.com/*"
  ],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "DRO — AI Market Intelligence", "default_popup": "popup.html"},
  "content_scripts": [{
    "matches": ["https://*.binance.com/*", "https://*.kucoin.com/*", "https://*.tradingview.com/*"],
    "js": ["stream.js", "content.js"],
    "run_at": "document_idle"
  }],
  "icons": {"128": "icon.svg"}
}
